<include>

  <extension name="mini_ivr_poc">
    <condition field="destination_number" expression="^9199$">

      <action application="answer"/>
      <action application="sleep" data="500"/>

      <action application="play_and_get_digits"
              data="1 1 3 5000 # $${sounds_dir}/poc/menu.wav $${sounds_dir}/poc/invalid.wav poc_choice ^[12]$ 2000"/>

      <action application="execute_extension"
              data="poc-${poc_choice} XML default"/>

    </condition>
  </extension>


  <extension name="mini_ivr_sales">
    <condition field="destination_number" expression="^poc-1$">
      <action application="playback"
              data="$${sounds_dir}/poc/sales.wav"/>
      <action application="hangup"/>
    </condition>
  </extension>


  <extension name="mini_ivr_support">
    <condition field="destination_number" expression="^poc-2$">
      <action application="curl" data="https://raw.githubusercontent.com/javabrown/jNet2/refs/heads/main/data/status.json"/>
      <action application="log" data="NOTICE HTTP=${curl_response_code} RESPONSE=${curl_response_data}"/>
      <action application="execute_extension" data="card-status-router XML default"/>
    </condition>
  </extension>





  <extension name="card_status_router">

    <condition field="destination_number" expression="^card-status-router$">

      <!-- HTTP call succeeded -->
      <condition field="${curl_response_code}" expression="^200$">

        <!-- Card is ready -->
        <condition field="${curl_response_data}" expression=".*ReadyToActivate.*">
          <action application="playback" data="$${sounds_dir}/poc/sales.wav"/>
          <action application="hangup"/>

          <!-- HTTP 200, but card is NOT ReadyToActivate -->
          <anti-action application="playback" data="$${sounds_dir}/poc/support.wav"/>
          <anti-action application="hangup"/>
        </condition>

        <!-- API returned something other than HTTP 200 -->
        <anti-action application="playback" data="$${sounds_dir}/poc/support.wav"/>
        <anti-action application="hangup"/>
      </condition>

    </condition>

  </extension>

</include>
